rules_version = '2';
// Pip's Sky Islands: every grown-up account can read and write ONLY its own data.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function okKid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['data', 'name', 'ts', 'v', 'deleted'])
        && (!('data' in d) || (d.data is string && d.data.size() < 900000))
        && (!('name' in d) || (d.name is string && d.name.size() <= 16));
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /kids/{kid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && okKid();
        // a removed player stays removed: an old offline device can't bring it back
        allow update: if isOwner(uid) && okKid() && resource.data.get('deleted', false) != true;

        match /backups/{backup} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.data is string
            && request.resource.data.data.size() < 900000;
        }
      }
    }
  }
}
