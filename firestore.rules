rules_version = '2';
// Pip's Sky Islands: every grown-up account can read and write ONLY its own data.
// Classes: a teacher owns a class; a child's grown-up shares a small progress summary with that class
// by knowing its class code; only the class's teachers (and the child's own grown-up) can read that summary.
// A class may have co-teachers (list "co"); they join with an invite code through a server function,
// see progress and manage tasks, but only the owner manages the roster, codes and deletion.
// Server-only data (mailstate, invites) is written by Cloud Functions with admin rights, never by apps.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function okKid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['data', 'name', 'ts', 'v', 'deleted', 'mail'])
        && (!('data' in d) || (d.data is string && d.data.size() < 900000))
        && (!('mail' in d) || (d.mail is string && d.mail.size() < 12000))
        && (!('name' in d) || (d.name is string && d.name.size() <= 16));
    }

    function signedIn() { return request.auth != null; }
    function str(v, n) { return v is string && v.size() <= n; }
    function okClassShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['owner', 'name', 'teacher', 'pack', 'code', 'ts', 'now', 'tasks', 'v', 'co', 'coNames', 'goal', 'goalHave', 'es'])
        && (!('es' in d) || d.es is bool) && (!('goal' in d) || okGoal(d.goal)) && (!('goalHave' in d) || (d.goalHave is int && d.goalHave >= 0 && d.goalHave < 10000000))
        && str(d.name, 40) && str(d.teacher, 40) && str(d.pack, 12)
        && str(d.code, 8) && (!('now' in d) || (d.now is list && d.now.size() <= 8))
        && (!('tasks' in d) || (d.tasks is list && d.tasks.size() <= 40))
        && (!('co' in d) || (d.co is list && d.co.size() <= 6))
        && (!('coNames' in d) || (d.coNames is map && d.coNames.size() <= 6));
    }
    // the class quest: one shared goal for a few days (right answers or minutes) and a reward the teacher names
    function okGoal(g) {
      return g == null || (g is map && g.keys().hasOnly(['kind', 'need', 'reward', 'start', 'end', 'ts'])
        && g.kind in ['right', 'min'] && g.need is int && g.need > 0 && g.need <= 100000
        && str(g.get('reward', ''), 60) && str(g.start, 10) && str(g.end, 10));
    }
    function okClass() { return okClassShape() && request.resource.data.owner == request.auth.uid; }
    function coList(d) { return d.get('co', []); }
    function okMember() {
      let d = request.resource.data;
      return d.keys().hasOnly(['owner', 'kid', 'name', 'pack', 'code', 'ts', 'sum', 'removed'])
        && d.owner == request.auth.uid && str(d.kid, 40) && str(d.name, 16) && str(d.pack, 12)
        && (!('sum' in d) || str(d.sum, 60000)) && d.get('removed', false) == false;
    }
    function classOwner(cid) { return get(/databases/$(database)/documents/classes/$(cid)).data.owner; }
    // the owner or a co-teacher of the class
    function classTeacher(cid) {
      let c = get(/databases/$(database)/documents/classes/$(cid)).data;
      return c.owner == request.auth.uid || request.auth.uid in c.get('co', []);
    }

    // class codes are looked up one at a time (never listed); a code can only point at the writer's own class
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['cid', 'owner'])
        && request.resource.data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.cid)).data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.cid)).data.code == code;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // a class holds no student data: its name, the teacher's display name, grade pack, topics and tasks
    match /classes/{cid} {
      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.get('co', []));
      allow create: if signedIn() && okClass() && coList(request.resource.data).size() == 0;
      // the owner edits anything, and may remove co-teachers (never add: adding goes through an invite code)
      allow update: if signedIn() && resource.data.owner == request.auth.uid && okClass()
        && coList(request.resource.data).toSet().difference(coList(resource.data).toSet()).size() == 0;
      // a co-teacher manages topics, tasks, lessons and the note to families
      allow update: if signedIn() && request.auth.uid in coList(resource.data) && okClassShape()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['now', 'tasks', 'ts', 'v', 'goal', 'goalHave']);
      // a co-teacher may leave the class
      allow update: if signedIn() && request.auth.uid in coList(resource.data) && okClassShape()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['co', 'coNames'])
        && coList(request.resource.data).toSet() == coList(resource.data).toSet().difference([request.auth.uid].toSet())
        && !(request.auth.uid in request.resource.data.get('coNames', {}));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // one child's summary; the id is "<grown-up uid>_<child id>"
      match /members/{mid} {
        allow get: if signedIn() && (resource == null || resource.data.owner == request.auth.uid || classTeacher(cid));
        allow list: if signedIn() && classTeacher(cid);
        // joining needs the class code (the teacher adds roster children without it)
        allow create: if signedIn() && mid.matches(request.auth.uid + '_.+') && okMember()
          && (classOwner(cid) == request.auth.uid
              || request.resource.data.code == get(/databases/$(database)/documents/classes/$(cid)).data.code);
        // the grown-up keeps the summary fresh until the teacher removes the child from the class
        allow update: if signedIn() && resource.data.owner == request.auth.uid
          && resource.data.get('removed', false) == false && okMember()
          && request.resource.data.get('code', '') == resource.data.get('code', '');
        // a teacher may only mark a child as removed
        allow update: if signedIn() && classTeacher(cid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed'])
          && request.resource.data.removed == true;
        // the grown-up may always delete the child's own summary (also after a removal, so the child can join again)
        allow delete: if signedIn() && (classTeacher(cid) || resource.data.owner == request.auth.uid);
      }
    }

    // co-teacher invite codes: made and seen by the class owner; redeemed only by the joinCoTeacher function
    match /tinv/{code} {
      allow get, delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['cid', 'owner', 'exp'])
        && request.resource.data.owner == request.auth.uid && request.resource.data.exp is int
        && get(/databases/$(database)/documents/classes/$(request.resource.data.cid)).data.owner == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // this account's devices that get notifications (one document per device token)
      match /push/{tok} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['t', 'ts', 'ua'])
          && str(request.resource.data.t, 600) && (!('ua' in request.resource.data) || str(request.resource.data.ua, 120));
      }

      match /kids/{kid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && okKid();
        // a removed player stays removed: an old offline device can't bring it back
        allow update: if isOwner(uid) && okKid() && resource.data.get('deleted', false) != true;

        match /backups/{backup} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.data is string
            && request.resource.data.data.size() < 900000;
        }
      }
    }
  }
}
